<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.pathly.RegisterActivity">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        android:src="@drawable/fondo_login"
        android:scaleType="centerCrop"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/white"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro de usuario"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#914037"
                android:layout_marginBottom="30dp"
                android:layout_marginTop="15dp"
                android:layout_gravity="center"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre"
                android:textColorHint="#37915D"
                android:drawableStart="@drawable/person"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:drawablePadding="10dp"
                android:inputType="text"
                android:textColor="#333333"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Correo electrónico"
                android:textColorHint="#37915D"
                android:drawableStart="@drawable/email"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:drawablePadding="10dp"
                android:inputType="textEmailAddress"
                android:textColor="#333333"
                android:layout_marginTop="15dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Contraseña"
                android:textColorHint="#37915D"
                android:drawableStart="@drawable/password"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:drawablePadding="10dp"
                android:layout_marginTop="15dp"
                android:inputType="textPassword"
                android:textColor="#333333"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etFechaNacimiento"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:hint="Fecha de nacimiento"
                    android:textColorHint="#37915D"
                    android:drawableStart="@drawable/calendary"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:drawablePadding="10dp"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textSize="8sp"
                    android:layout_gravity="left"
                    android:layout_marginRight="10dp" />

                <EditText
                    android:id="@+id/etEdad"
                    android:layout_width="95dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:hint="Edad"
                    android:textColorHint="#37915D"
                    android:drawableStart="@drawable/edad"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:drawablePadding="10dp"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textSize="8sp"
                    android:layout_gravity="right"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etAltura"
                    android:layout_width="123dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:hint="Altura"
                    android:textColorHint="#37915D"
                    android:drawableStart="@drawable/altura"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:drawablePadding="10dp"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_gravity="left"
                    android:layout_marginRight="10dp" />

                <EditText
                    android:id="@+id/etPeso"
                    android:layout_width="122dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:hint="Peso"
                    android:textColorHint="#37915D"
                    android:drawableStart="@drawable/peso"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:drawablePadding="10dp"
                    android:inputType="text"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:layout_gravity="right"/>

            </LinearLayout>





            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_button"
                android:text="Iniciar Sesión"
                android:textColor="#914037"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>