<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1EDC0"
    android:fillViewport="true"
    tools:context=".DetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PERFIL DEL USUARIO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#AD98A9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <ImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:contentDescription="Foto de perfil"
                    android:tint="#914037"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mi perfil"
                        android:textColor="#914037"
                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre completo: Pendiente"
                        android:textColor="#443025"
                        android:textSize="13sp"
                        android:layout_marginTop="5dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edad: --"
                        android:textColor="#443025"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Género: --"
                        android:textColor="#443025"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TITULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MI ACTIVIDAD"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#914037"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp"/>

        <!-- PRIMERA FILA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- TARJETA DEL CLIMA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#37915D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="280dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CLIMA"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <!-- UBICACION DEL API -->
                    <TextView
                        android:id="@+id/tvDetalleUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ubicación"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="10dp"/>

                    <!-- TEMPERATURA DEL API -->
                    <TextView
                        android:id="@+id/tvDetalleTemperatura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-- °C"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="8dp"/>

                    <!-- ESTADO DEL CLIMA -->
                    <TextView
                        android:id="@+id/tvDetalleEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado del clima"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"/>

                    <!-- HUMEDAD -->
                    <TextView
                        android:id="@+id/tvDetalleHumedad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Humedad: --"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"/>

                    <!-- SENSACION TERMICA -->
                    <TextView
                        android:id="@+id/tvDetalleSensacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sensación: --"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp"/>

                    <!-- BOTON FAVORITOS -->
                    <ImageButton
                        android:id="@+id/btnFavorito"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button"
                        android:src="@drawable/no_favorito"
                        android:contentDescription="Agregar a favoritos"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:tint="#914037"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA RECOMENDACIONES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#37915D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="280dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RECOMENDACIONES"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Consulta información útil para tus recorridos."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="15dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SEGUNDA FILA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- TARJETA KILOMETROS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#37915D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KILÓMETROS RECORRIDOS"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin recorridos registrados."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="15dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA HIDRATACION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#37915D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RECORDATORIO DE HIDRATACIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recuerda tomar agua durante tus recorridos."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="15dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
